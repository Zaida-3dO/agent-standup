#!/bin/sh
# Pre-push gate: runs the same fast checks CI's build-and-test job runs first,
# before any push leaves this machine. It only runs the checks that need
# nothing but the source tree — no database, no container — because those are
# also the checks CI fails on most often. A slow hook gets bypassed and then
# protects nothing, so the full test suite is deliberately NOT here; it still
# runs in CI, on every PR.
#
# Installed automatically by `npm install` via the `prepare` script, which
# points git at this directory with `git config core.hooksPath .githooks`.
# That is the whole install step — nothing to remember, nothing to run by
# hand. Git invokes hook files under core.hooksPath directly (no npm, no
# node wrapper needed), and does so with `sh` on both platforms — Git for
# Windows ships its own POSIX shell for exactly this reason — so this one
# script covers Windows and Linux without a platform branch.
#
# Bypass in an emergency: git push --no-verify

# ── Is there any content to check? ──────────────────────────────────────
#
# Git feeds a pre-push hook one line per ref being pushed, on stdin:
#
#     <local ref> <local sha> <remote ref> <remote sha>
#
# A DELETION is signalled by an all-zero local sha — there is no local
# commit, because the point of the push is to remove the remote ref. A
# branch deletion carries no content, so there is nothing to format and
# nothing to lint, and running the checks anyway means a housekeeping push
# is gated on the state of a working tree that has no bearing on it.
#
# If every ref being pushed is a deletion, the checks are skipped. A push
# that mixes a deletion with a real update still runs them, because that
# push does carry content.
#
# Reading stdin is safe when it is empty (git supplies nothing on some
# paths): the loop simply does not execute, `has_content` stays 0, and the
# checks are skipped — which is the right answer for a push with no refs.
has_content=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    # All zeros, of any length: git has used 40 hex digits for SHA-1 and
    # will use 64 for SHA-256, so this matches the shape rather than a
    # fixed width.
    *[!0]*) has_content=1 ;;
    "") ;;
    *) ;;
  esac
done

if [ "$has_content" -eq 0 ]; then
  echo "pre-push: nothing to check (no commits being pushed — a deletion carries no content)."
  exit 0
fi

# ── "Could not run" is not "failed" ─────────────────────────────────────
#
# Three outcomes, not two: ran-and-passed, ran-and-failed, and could-not-run.
# Collapsing the third into either of the others is the defect. If the checks
# cannot run at all — no `node_modules`, so no prettier and no eslint — then
# reporting "fix the above" points at a code defect that does not exist and
# sends the reader looking for it. A gate that cannot run must say so rather
# than fail as though it had a verdict.
#
# WHY THIS IS CHECKED UP FRONT RATHER THAN READ OFF AN EXIT CODE.
#
# Keying this on npm exiting 127 alone is not enough, because that is not
# the code the common case produces. There are two distinct absences, and
# only one of them produces 127:
#
#   * `npm` itself missing — the *shell* cannot find the command, so it
#     returns 127. Real, but rare: anyone with a checkout has npm.
#   * `npm` present, `node_modules` absent — npm runs fine, the script runs,
#     and `prettier` is what is not found. npm reports that child's failure
#     as its own exit status, which is **1** on Windows. Indistinguishable
#     from a genuine lint failure by exit code alone.
#
# The second is the fresh-worktree case, and every crew works in a fresh
# worktree, so it fires on the normal case rather than an edge one. It was
# blocked with exactly the message the comment above forbids, which teaches
# `--no-verify` as a reflex — and a bypass already in muscle memory is what
# makes the next real block useless.
#
# So the primary signal is the presence of the tools themselves, tested
# before anything runs. That is platform-independent (no exit code is
# consulted to decide it), and it cannot be confused with a check that ran
# and had a verdict, because nothing has run yet at the point it is decided.
#
# A missing `npm` is the other absence, and it cannot be decided this way —
# answering it means trying to run the thing. It is handled after the checks
# run, on the shell's own 127. Both signals are kept: neither subsumes the
# other, and dropping either puts an absence back on the "failed" path.
BIN_DIR="$(dirname "$0")/../node_modules/.bin"

missing_tools=""
for tool in prettier eslint; do
  # `.cmd` is the Windows shim npm installs alongside the POSIX launcher.
  # Both are checked so this one unbranched script keeps covering both
  # platforms.
  if [ ! -e "$BIN_DIR/$tool" ] && [ ! -e "$BIN_DIR/$tool.cmd" ]; then
    missing_tools="$missing_tools $tool"
  fi
done

if [ -n "$missing_tools" ]; then
  echo "pre-push: checks DID NOT RUN — not installed in this checkout:$missing_tools"
  echo "pre-push: this is not a pass and not a failure — nothing was checked."
  echo "pre-push: run 'npm ci' if you want these checks locally. Not blocking; CI runs them on every PR."
  exit 0
fi

echo "pre-push: running format:check and lint (see CLAUDE.md for what this checks and how to skip it)"

npm run format:check
format_status=$?

npm run lint
lint_status=$?

# The second could-not-run signal, kept alongside the probe above because the
# two catch different absences and neither subsumes the other.
#
# The probe catches a missing `node_modules` — the common case — and cannot
# catch a missing `npm`, because deciding that requires trying to run it.
# This catches a missing `npm`: the shell returns 127 for a command it cannot
# find, and that 127 is the *shell's*, which makes it reliable on every
# platform in a way npm's own exit status is not.
#
# Keeping only the probe would let a checkout with dependencies installed but
# no npm on PATH report "blocked" for an absence, which is the same
# could-not-run-as-failed defect in a different guise.
TOOL_MISSING=127

if [ "$format_status" -eq "$TOOL_MISSING" ] || [ "$lint_status" -eq "$TOOL_MISSING" ]; then
  echo ""
  echo "pre-push: checks DID NOT RUN — npm could not be found, so nothing was checked."
  echo "pre-push: this is not a pass and not a failure — nothing was checked."
  echo "pre-push: Not blocking; CI runs these on every PR."
  exit 0
fi

if [ "$format_status" -ne 0 ] || [ "$lint_status" -ne 0 ]; then
  echo ""
  echo "pre-push: blocked — fix the above, or bypass with 'git push --no-verify' (emergency use only, CI still runs these)."
  exit 1
fi

# ── Say "passed", out loud, even when output was printed ────────────────
#
# Every other outcome above announces itself; without this line the PASSING
# path is the one that says nothing. That silence is the problem, because
# eslint prints its warnings whether or not they affect the verdict: a repo
# with warnings outstanding ends a successful run with a wall of yellow and
# `✖ N problems (0 errors, N warnings)`, and then the hook exits 0 without
# comment. The push proceeds, but the reader has no way to know that from
# the output, and reasonably concludes they were refused for findings in
# files they never touched.
#
# That is not hypothetical — it was filed as a P2 against this hook, with
# the warning count quoted as evidence, by a crew that had genuinely walked
# the new-contributor path. The gate was correct; only its silence was not.
#
# Warnings are advisory BY DESIGN here: `eslint` exits non-zero on errors
# alone (no `--max-warnings` is passed, here or in CI), and the rules this
# repo actually enforces — the database-client import allowlist and the
# events-backfill boundary in eslint.config.mjs — are severity `error`, so
# they block exactly as intended. Naming that distinction is the whole job
# of this line: it tells a first-time contributor which of the two things
# they are looking at, at the only moment they need to know.
echo ""
echo "pre-push: passed — pushing."
echo "pre-push: any warnings above are advisory and did not block this push; only errors do."

exit 0
