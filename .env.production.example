# Template for `.env.production` — the file `docker-compose.prod.yml` reads.
#
#     cp .env.production.example .env.production
#
# then fill in the four settings below. `.env.production` is gitignored; this
# template is the only one of the pair that is committed, so keep real tokens
# out of this file.
#
# This is the DEPLOYMENT template, and a different file from `.env.example`,
# which configures a local development checkout. The two overlap only in
# DATABASE_URL, and even there they point at different databases: the port
# 5433 in `.env.example` is a local convenience that has no bearing here.
#
# Every setting below is read by `docker-compose.prod.yml` as `${VAR:?...}`,
# which means compose REFUSES TO START while any of them is unset and names
# the one that is missing. That is the intended behaviour, so an incomplete
# file fails loudly at `up` rather than booting a half-configured server.

# ── The container image to run ──────────────────────────────────────────
#
# Built and pushed by CI. The package is public, so no registry credential is
# needed to pull it. Replace OWNER with the GitHub owner of the repository —
# for the upstream project that is `zaida-3do` (the path is lowercased by
# GHCR regardless of how the owner name is capitalised).
GHCR_IMAGE=ghcr.io/OWNER/agent-standup:latest

# ── The database this server owns ───────────────────────────────────────
#
# A real, persistent Postgres — not the disposable one `npm run db:up` starts
# for development. The server applies its own migrations on boot.
#
# If Postgres runs as a sibling container in this same compose project, the
# host is that service's name rather than `localhost`: inside a container,
# `localhost` is the container itself. See README §Deployment.
DATABASE_URL=postgres://user:password@host:5432/agent_standup

# ── Per-machine bearer tokens ───────────────────────────────────────────
#
# `machine:token` pairs, comma-separated — one per machine that will call the
# API or the MCP mount. There is no default: with this unset the server
# refuses every authenticated call, deliberately, so that a deployment whose
# configuration failed to arrive is shut rather than open.
#
# The web front end needs an entry of its own named exactly `browser`.
# The sweeper needs one too — name it whatever you like, then repeat that
# machine's token as SWEEP_TOKEN below.
#
# Generate each token with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
STANDUP_TOKENS=browser:REPLACE_ME,laptop:REPLACE_ME_TOO,sweeper:REPLACE_ME_THREE

# ── The sweeper's own token ─────────────────────────────────────────────
#
# The `sweep-scheduler` service authenticates with this. It must be the TOKEN
# HALF of one of the pairs in STANDUP_TOKENS above — the `sweeper:` entry in
# the example line, i.e. REPLACE_ME_THREE. A token that appears here but not
# there resolves to no machine and every sweep is refused.
SWEEP_TOKEN=REPLACE_ME_THREE

# ── Optional — every one of these has a working default ─────────────────
#
# Listed so they are discoverable; leave them commented out unless you need
# to change one. Unlike the four above, an unset value here is fine.
#
# The host port the server answers on. Change it if 3000 is taken.
# APP_PORT=3000
#
# Timezone for the container, which is what dates in the UI are rendered in.
# TZ=UTC
#
# How long the entrypoint waits for Postgres to accept a query before giving
# up, and how often it retries. The defaults already cover a slow cold boot.
# DB_WAIT_TIMEOUT_SECONDS=180
# DB_WAIT_INTERVAL_SECONDS=2
#
# Where the sweeper reaches the server. The default is the app's service name
# on the compose network, which is correct unless you have renamed it.
# SWEEP_URL=http://agent-standup:3000
#
# How often a sweep runs, and how long one may take before it is abandoned.
# SWEEP_INTERVAL_SECONDS=300
# SWEEP_TIMEOUT_SECONDS=30
