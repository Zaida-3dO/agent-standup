{
  "name": "agent-standup",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "standup": "dist/bin/standup.js",
    "standup-hook": "dist/bin/standup-hook.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "prepack": "npm run build:cli",
    "dev": "next dev",
    "build": "next build",
    "build:cli": "node scripts/build-cli.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "test:mutate": "node scripts/run-mutation-tests.mjs",
    "test:mutate:changed": "node scripts/run-mutation-tests.mjs --changed-only",
    "check:external-refs": "node scripts/check-external-refs.mjs",
    "generate:http-routes": "node scripts/generate-http-routes.mjs",
    "check:http-routes": "node scripts/generate-http-routes.mjs --check",
    "check:db-imports": "node scripts/check-db-import-allowlist.mjs",
    "check:event-emitters": "node scripts/check-event-emitters.mjs",
    "check:db-gated": "node scripts/check-db-gated-suites.mjs",
    "check:operation-metadata": "node scripts/check-operation-metadata-mutants.mjs",
    "check:db-gated:require": "node scripts/check-db-gated-suites.mjs --require-db",
    "version:from-tag": "node scripts/version-from-tag.mjs",
    "db:up": "node scripts/db-up.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:check-drift": "node scripts/check-migration-drift.mjs",
    "db:seed": "node prisma/seed.mjs",
    "backfill": "node scripts/backfill.mjs",
    "test:raw": "vitest run"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.32.0",
    "next": "^16.0.0",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.24.0"
  },
  "overrides": {
    "qs": "^6.15.2",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^26.1.0",
    "pg": "^8.23.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
