DATABASE_URL=postgres://standup:standup@localhost:5433/standup
# Development and CI only — the disposable database the migration drift
# check (`npm run db:check-drift`) drops and rebuilds. Never points at
# anything worth keeping.
# SHADOW_DATABASE_URL=postgres://standup:standup@localhost:5433/standup_shadow
# Boot sequence — how long scripts/entrypoint.mjs waits for Postgres to
# accept a query before giving up, and how often it retries. Commented out
# here because the default (below) already covers a slow cold boot; unset
# uses it. If set, must be a whole or decimal number of seconds > 0 — an
# empty value is treated the same as an invalid one, not as "unset".
# DB_WAIT_TIMEOUT_SECONDS=180
# DB_WAIT_INTERVAL_SECONDS=2
# The liveness sweep's schedule — read by scripts/sweep-schedule.mjs, which
# runs as its own process beside the app (docker-compose.prod.yml's
# `sweep-scheduler`) because a schedule belongs to the deployment rather
# than to a per-replica timer inside the bundle. STANDUP_URL is where the
# app answers and has no default; the two durations follow the same rule as
# the boot knobs above, where an empty value is invalid rather than unset.
# STANDUP_URL=http://localhost:3000
# SWEEP_INTERVAL_SECONDS=300
# SWEEP_TIMEOUT_SECONDS=60
#
# Everything else the application reads is a database setting with a
# code-side default, not an environment variable — configure it via
# /settings or `standup config set` once the app is running. See
# docs/plans/SCHEMA.md §17 for the full registry and why the line sits here.
