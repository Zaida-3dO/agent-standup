// Agent Standup — full reasoning lives in docs/plans/SCHEMA.md.
// Two rules govern this file:
//   1. Store facts, derive volatiles. Every denormalisation carries a reason.
//   2. A satellite table needs a structural reason: editable, referenced by a
//      guard, or cardinality-constrained. Otherwise it is an event or a value.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemKind {
  project
  task
  subtask
}

enum Priority {
  P0
  P1
  P2
  P3
}

enum OriginType {
  person
  source
  auto
}

enum DriveMode {
  autonomous
  supervised
  manual
}

enum MergeAuthority {
  pre_approved
  needs_approval
  agent_judgement
}

enum BlockedOnType {
  person
  external_process
  time
}

enum Facet {
  reasoning
  breadth
  precision
  autonomy
  visual
  writing
}

enum ItemState {
  someday
  on_deck
  planning
  plan_review
  executing
  in_review
  paused
  blocked
  merged
  research_done
  wont_do
  cancelled
}

model Item {
  id                String         @id
  parentId          String?
  parent            Item?          @relation("Tree", fields: [parentId], references: [id])
  children          Item[]         @relation("Tree")
  kind              ItemKind
  title             String
  body              String         @db.Text
  state             ItemState
  priority          Priority       @default(P2)
  originType        OriginType
  originPersonId    String?
  originPerson      Person?        @relation("Origin", fields: [originPersonId], references: [id])
  area              String
  areaRef           Area           @relation(fields: [area], references: [id])
  repo              String?
  repoRef           Repo?          @relation(fields: [repo], references: [id])
  branch            String?
  needsVisualReview Boolean        @default(false)
  driveMode         DriveMode      @default(autonomous)
  mergeAuthority    MergeAuthority
  blockedReason     String?
  blockedOnType     BlockedOnType?
  blockedOnPersonId String?
  blockedOnPerson   Person?        @relation("BlockedOn", fields: [blockedOnPersonId], references: [id])
  unblockAt         DateTime?      @db.Timestamptz(3)
  pauseReason       String?
  resumeCondition   String?
  resumeAttempts    Int            @default(0)
  difficulty        Json?
  sourceRef         String?
  notify            Json?
  estimatedCost     Decimal?
  customFields      Json?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  completedAt       DateTime?      @db.Timestamptz(3)

  assignments Assignment[]
  events      Event[]
  artifacts   Artifact[]
  summary     Summary?
  runs        Run[]
  // Reviews that deferred their findings into THIS item — the back-reference
  // of `Artifact.followUpItemId`. Named for the direction it reads in:
  // "which reviews are relying on this item existing".
  followUpFor Artifact[] @relation("ArtifactFollowUp")

  @@index([state])
  @@index([parentId])
  @@index([area])
  @@index([repo])
  @@index([state, priority])
  @@index([sourceRef])
}

// Installation-owned reference data (SCHEMA.md §23) — not build-owned
// configuration, so it does not live in the settings registry (#77).
// Two tables, not one taxonomy table with a discriminator, because they
// have different create postures (DECISIONS.md §13g):
//   - Repo is created deliberately (explicit call only, never a side effect
//     of an import) — a wrong repo aims the merge gate at the wrong repo.
//   - Area is auto-created on first use, with normalisation — required on
//     every item, so blocking that write is friction nobody should pay.
model Repo {
  id                String    @id
  displayName       String
  defaultBranch     String
  host              String?
  needsVisualReview Boolean   @default(false)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  archivedAt        DateTime? @db.Timestamptz(3)

  items Item[]
}

model Area {
  id          String    @id
  displayName String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)

  items Item[]
}

enum Role {
  orchestrator
  builder
  reviewer
  visual_reviewer
  scout
  custom
}

enum HolderType {
  person
  agent
}

enum Liveness {
  running
  stalled
  dead
  superseded
}

model Assignment {
  id              String     @id @default(uuid())
  itemId          String
  item            Item       @relation(fields: [itemId], references: [id])
  role            Role
  roleCustom      String?
  holderType      HolderType
  holderId        String
  sessionId       String
  parentSessionId String?
  rootSessionId   String
  machine         String
  pid             Int?
  branch          String?
  worktree        String?
  liveness        Liveness   @default(running)
  supersededBy    String?
  claimedAt       DateTime   @default(now()) @db.Timestamptz(3)
  lastActive      DateTime   @default(now()) @db.Timestamptz(3)
  releasedAt      DateTime?  @db.Timestamptz(3)
  model           String?
  effort          String?

  events Event[]
  runs   Run[]

  @@index([sessionId])
  @@index([itemId, role])
  @@index([rootSessionId])
}

enum ActorType {
  person
  agent
  system
}

enum EventType {
  field_change
  state_change
  claim
  release
  takeover
  review_requested
  review
  merge
  dispatch
  dispatch_claimed
  checkpoint
  nudge
  escalation
  note
  // A settings write — set, cleared or patched (SCHEMA.md §17.2, §17.8).
  // `itemId` is null: this is a system-level event, not scoped to an item.
  setting_change
  // An open loop opened, and the same loop closed (SCHEMA.md §3a). A loop is
  // an event pair, not an item and not a row of its own: it has no state
  // machine, no assignee, no review and no merge, so modelling it as an item
  // would put it on the board and into every count that ranges over items.
  // The pairing is by `payload.loopId`; a loop is OPEN exactly when its
  // `open_loop` has no matching `open_loop_closed` — see src/lib/open-loops.ts.
  //
  // This is what lets an `executing` item carry an open loop at all. The
  // other source, `Summary.notDone`, is 1:1 with an item and only written at
  // completion, so before this an in-flight item had nowhere to put one.
  open_loop
  open_loop_closed
}

model Event {
  id           BigInt      @id @default(autoincrement())
  // The identifier of the transaction that wrote this row, defaulted by
  // Postgres itself (`txid_current()`) rather than supplied by the
  // application — SCHEMA.md §3. `id` is handed out before commit, so
  // sequence order is not commit order; `txId` is what lets a reader bound
  // itself to rows whose writing transaction has definitely finished (the
  // visibility horizon) instead of trusting `id` alone. Two rows written by
  // the same call share a `txId` because they share the one transaction the
  // service runtime opens per call.
  txId         BigInt      @default(dbgenerated("txid_current()"))
  itemId       String?
  item         Item?       @relation(fields: [itemId], references: [id])
  ts           DateTime    @default(now()) @db.Timestamptz(3)
  actorType    ActorType
  actorId      String?
  sessionId    String?
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  type         EventType
  payload      Json
  body         String?     @db.Text
  seenBy       EventSeen[]

  @@index([itemId, ts])
  @@index([type, ts])
  @@index([assignmentId, type, ts])
  @@index([txId])
}

model EventSeen {
  eventId  BigInt
  event    Event    @relation(fields: [eventId], references: [id])
  personId String
  person   Person   @relation(fields: [personId], references: [id])
  seenAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([eventId, personId])
}

model Summary {
  itemId      String   @id
  item        Item     @relation(fields: [itemId], references: [id])
  shipped     Json
  notDone     Json
  userFacing  Boolean
  whatToTest  Json?
  howVerified String?
  watchFor    Json
  finalState  Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

enum ArtifactKind {
  plan
  plan_review
  code_review
  visual_review
  test_run
  commit
  screenshot
  other
}

// Review verdicts, tiered (SCHEMA.md §6a). The tier is what decides how much
// re-review the next round costs, so it is a stored fact, not something a
// reader infers from prose in `body`:
//
//   `lgtm`                 clean; merge.
//   `lgtm_with_nits`       shippable, cosmetic findings left. Merges only
//                          once the nits are addressed — which the
//                          tip-currency check enforces for free: an
//                          addressing commit moves the tip, so the approval
//                          names a commit that is not the tip, and a light
//                          re-review at the new tip is required
//                          (see guards/merge.ts).
//   `lgtm_with_followups`  the findings are real but not blocking THIS
//                          change; merges immediately, **only** if a
//                          follow-up item is linked (`followUpItemId`).
//   `changes_required`     blocking; full fresh review.
//
// `approved` and `na` predate the tiering. Neither can be removed — dropping
// a label from a Postgres enum is not an `ALTER`-shaped change, it is a type
// rebuild — so `approved` is retained as an accepted synonym of `lgtm` and
// `na` keeps its own meaning ("this artifact kind has no verdict to give").
// `src/lib/verdicts.ts` is the single place that says which of these approve.
enum Verdict {
  approved
  changes_required
  na
  lgtm
  lgtm_with_nits
  lgtm_with_followups
}

model Artifact {
  id             String       @id @default(uuid())
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id])
  kind           ArtifactKind
  verdict        Verdict?
  reviewRound    Int          @default(1)
  commitSha      String?
  body           String?      @db.Text
  ref            String?
  browserSession String?
  // The review's individual findings, each with a severity (SCHEMA.md §6a).
  // A review's findings are a LIST of typed things, not one thing — a
  // severity per finding is the whole point, and flattening them into `body`
  // loses it. `Json?` rather than a satellite table because a finding has no
  // structural reason to be a row (schema.prisma's own header rule): it is
  // never edited independently, never referenced by a guard, and never
  // cardinality-constrained — it is a value belonging to exactly one
  // artifact, read back whole.
  //
  // The severity vocabulary and the shape of an entry are validated in code
  // (`src/lib/findings.ts`), not by the column: Postgres cannot apply an
  // enum type to a value nested inside jsonb, so a check constraint here
  // would be a hand-written re-implementation of the same list in SQL, free
  // to drift from the one the application validates against.
  findings       Json?
  // The follow-up item this review's findings were deferred into — required
  // by the merge gate when `verdict` is `lgtm_with_followups`, and null for
  // every other verdict (guards/merge.ts `merge.requires_linked_followup`).
  //
  // A real foreign key, deliberately, rather than an id in `customFields`:
  // the whole reason `lgtm_with_followups` merges without another round is
  // that the deferred work is genuinely recorded somewhere, and a bare
  // string can name an item that never existed. It is also NOT modelled as a
  // child of the reviewed item — a child in an actionable state would trip
  // `hierarchy.no_finish_with_actionable_child` and block the very merge
  // this verdict exists to permit.
  followUpItemId String?
  followUpItem   Item?        @relation("ArtifactFollowUp", fields: [followUpItemId], references: [id])
  createdByType  HolderType
  createdById    String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([itemId, kind, reviewRound])
  @@index([followUpItemId])
  // Storage-side only — nothing in the application queries findings yet. It
  // is here rather than in a later migration because it is the difference
  // between "severity is recorded" and "severity can be asked about", and
  // adding it afterwards means an index build over a table that by then
  // holds every review the installation has ever produced.
  @@index([findings(ops: JsonbPathOps)], type: Gin)
}

model Person {
  id          String    @id
  displayName String
  avatar      String?
  colour      String?
  notifyRules Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)

  originItems    Item[]          @relation("Origin")
  blockedItems   Item[]          @relation("BlockedOn")
  seen           EventSeen[]
  authorizations Authorization[]
}

model Authorization {
  id          String    @id
  grantedById String
  grantedBy   Person    @relation(fields: [grantedById], references: [id])
  grantedAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  scope       Json
  grantText   String    @db.Text
}

model Agent {
  name      String    @id
  roleHint  Role?
  persona   String?
  retiredAt DateTime? @db.Timestamptz(3)

  // The pre-item hold (MILESTONES.md #34, src/lib/agent-names.ts). A name is
  // "handed out" the moment a session takes it and stays held until that
  // session releases it or the name is retired — independent of
  // `Assignment`, which cannot exist before an item does (`Assignment.itemId`
  // is required) and so cannot represent "this session has claimed a crew
  // name but hasn't touched an item yet". Both columns are set and cleared
  // together; `heldAt` is never read on its own.
  heldBySessionId String?
  heldAt          DateTime? @db.Timestamptz(3)
}

model ToolCall {
  id               BigInt     @id @default(autoincrement())
  sessionId        String
  assignmentId     String?
  itemId           String?
  ts               DateTime   @default(now()) @db.Timestamptz(3)
  tool             String
  command          String?    @db.Text
  paths            String[]
  stateAt          ItemState?
  inputTokens      Int        @default(0)
  outputTokens     Int        @default(0)
  cacheWriteTokens Int        @default(0)
  cacheReadTokens  Int        @default(0)
  usage5h          Decimal?
  usageWeekly      Decimal?

  @@index([sessionId, ts])
  @@index([itemId, ts])
}

enum RunOutcome {
  completed
  stalled
  superseded
  failed
}

enum SelectionReason {
  recommended
  exploration
  override
  pinned
}

model Run {
  id                     String          @id @default(uuid())
  itemId                 String
  item                   Item            @relation(fields: [itemId], references: [id])
  assignmentId           String
  assignment             Assignment      @relation(fields: [assignmentId], references: [id])
  startedAt              DateTime        @default(now()) @db.Timestamptz(3)
  endedAt                DateTime?       @db.Timestamptz(3)
  model                  String
  effort                 String
  selectionReason        SelectionReason
  recommendationStrength Decimal?
  inputTokens            BigInt          @default(0)
  outputTokens           BigInt          @default(0)
  cacheWriteTokens       BigInt          @default(0)
  cacheReadTokens        BigInt          @default(0)
  cost                   Decimal?
  toolCallCount          Int             @default(0)
  turnCount              Int             @default(0)
  outcome                RunOutcome?
  reworkRequired         Boolean         @default(false)
  blockingFindings       Int             @default(0)
  steeringInterventions  Int             @default(0)

  scores RunScore[]
}

model RunScore {
  id           String    @id @default(uuid())
  runId        String
  run          Run       @relation(fields: [runId], references: [id])
  facet        Facet
  agentScore   Int?
  userScore    Int?
  userScoredBy String?
  userScoredAt DateTime? @db.Timestamptz(3)

  @@unique([runId, facet])
}

enum PlanType {
  subscription
  metered
}

model Account {
  id            String           @id
  vendor        String
  displayName   String
  planType      PlanType
  usage5h       Decimal?
  usageWeekly   Decimal?
  usageAt       DateTime?        @db.Timestamptz(3)
  // Per-entity override of the `budget.windows` setting (SCHEMA.md §17.7).
  // Null means "no override" — this account uses the global value. Bands
  // key off the account and planType makes them mean different things, so
  // one global value cannot describe two accounts. Validated by the
  // registry's own validator, not a second schema: an override changes
  // where a value is stored, never its type.
  budgetWindows Json?            @map("budget_windows")
  machines      MachineAccount[]
}

model Machine {
  name         String           @id
  lastPollAt   DateTime?        @db.Timestamptz(3)
  liveSessions Int              @default(0)
  // Per-entity override of the `minting.source_globs` setting (§17.7).
  // Null means "no override". Filesystem globs are a property of a machine
  // and machines have different layouts. Same validator as above.
  sourceGlobs  String[]         @map("source_globs")
  accounts     MachineAccount[]
}

model MachineAccount {
  machineName String
  machine     Machine @relation(fields: [machineName], references: [name])
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])

  @@id([machineName, accountId])
}

// Settings — overrides only (SCHEMA.md §17.2). Key, schema, default, label,
// help and category are declared in code, in src/lib/settings/registry.ts;
// a row exists here exactly when someone has deliberately set a key. A
// fresh database therefore boots fully working with this table empty.
//
// Never a secret store: every value is served to the front end and printed
// by the command line, with no redaction path. A value that must not be
// read aloud belongs in the bootstrap environment, and the registry's own
// test fails the build on a credential-shaped key.
model Setting {
  key           String    @id
  // JSON null is a legal, meaningful value ("explicitly nothing" —
  // notifications off, retention forever) and is NOT the same as no row,
  // which means "at the default". Hence Json, not Json? — the column is
  // NOT NULL and stores the JSON scalar null when that is what was chosen.
  value         Json
  updatedAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedByType ActorType
  // → people.id or agents.name. Null for `system`.
  updatedById   String?

  @@map("settings")
}

// One row, one number (§17.2). Bumped in the same transaction as every
// settings write, including a delete.
//
// A counter rather than max(settings.updated_at), because clearing an
// override deletes a row and a delete can lower a maximum — a change that
// moves state backwards would be invisible to anything watching a
// high-water mark. The counter only goes up, so "have settings changed
// since I last looked" is one comparison. It doubles as the entity tag for
// GET /settings and as the cheap re-read signal for any process holding a
// cached snapshot.
model SettingsRevision {
  // Always 1: a single row, enforced by the check constraint the migration
  // adds. Prisma cannot express a check constraint, so the guarantee lives
  // in the migration and is asserted by a test that tries to insert a
  // second row and is refused.
  id       Int    @id @default(1)
  revision BigInt @default(0)

  @@map("settings_revision")
}

// One row per capability setting whose path the liveness sweep re-verifies
// (`notify.doc`, `visual_review.doc` — SCHEMA.md §17.5, DECISIONS.md §13f).
// "Checked" is a fact about whichever machine ran the sweep, so the stored
// state is who checked it, when, and what they found — never a bare
// boolean, because a boolean can't distinguish "verified" from "the machine
// that checked it could not see that filesystem" from "nobody has checked
// since it changed". One row is overwritten in place per key: this is the
// *latest* result, not a history — the ledger already has `events` for
// anyone who wants the trail, via a `setting-change`-adjacent write this
// milestone does not add (out of scope for row #24; see the sweep itself).
model CapabilityCheck {
  // The settings key this check is about (`notify.doc`, `visual_review.doc`,
  // …). Not a foreign key into `settings` — a capability with no override
  // row still resolves to its default and, when non-null, still needs
  // checking; keying on the registry key rather than a settings row keeps
  // that true.
  key               String                @id
  // The path or URL that was checked. Recorded alongside the result so this
  // row stays visibly about the path it actually checked, rather than being
  // silently reattributed to whatever the setting reads now if the setting
  // has since been edited to point somewhere else.
  path              String
  result            CapabilityCheckResult
  // Who ran the sweep. Never `person` — the sweep is a server or command-line
  // process, not a human click — but typed the same way every other actor
  // reference in this schema is, rather than a bare machine name, so a
  // reader does not need a second lookup to know what kind of thing checked.
  // `lastCheckedById` is nullable for the same reason `events.actor_id` is
  // (SCHEMA.md §3): required unless the type is `system`, null for `system`.
  lastCheckedByType ActorType
  lastCheckedById   String?
  lastCheckedAt     DateTime              @db.Timestamptz(3)

  @@map("capability_checks")
}

// `exists`: the path was reachable and present, where the checking process
// could see that filesystem. `missing`: reachable to check, and absent —
// the loud warning case SCHEMA.md §17.5's "Still exists" row describes.
// `unverified`: the process could not determine either way (no filesystem
// access to the path, e.g. a URL or a path on a machine the sweep does not
// run on) — recording "I could not check" rather than a false pass, per
// §17.5's "Accept, mark unverified" row.
enum CapabilityCheckResult {
  exists
  missing
  unverified
}
